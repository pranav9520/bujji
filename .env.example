# Local configuration only. Never commit .env or share its token/keys.
# setup.ps1 creates a random owner token; packaged Windows builds do this automatically.
BUJJI_TOKEN=
BUJJI_USER_NAME=
BUJJI_DATA_DIR=data
BUJJI_FILE_ROOT=data/inbox
BUJJI_TIMEZONE=UTC
BUJJI_DESKTOP_PORT=8765

# Set exact enabled model IDs from your provider account. Blank means unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=

# First-run defaults use one provider. Settings > AI task routing can split roles.
BUJJI_DAILY_PROVIDER=gemini
BUJJI_STUDY_PROVIDER=gemini
BUJJI_RESEARCH_PROVIDER=gemini
BUJJI_CODING_PROVIDER=gemini
BUJJI_WRITING_PROVIDER=gemini
BUJJI_ANALYSIS_PROVIDER=gemini
OLLAMA_ENABLED=false
OLLAMA_MODEL=

# Voice input and output are independent. Gemini transcription needs audio input support.
BUJJI_STT_PROVIDER=gemini
# GEMINI_STT_MODEL=
# GROQ_STT_MODEL=whisper-large-v3-turbo
# Desktop cloud speech is optional and requires a supported Gemini TTS model/key.
# Android uses its installed device voice. No voice model is downloaded by default.
BUJJI_TTS_PROVIDER=gemini
# GEMINI_TTS_MODEL=
# GEMINI_DOCUMENT_MODEL=

# Optional, off unless explicitly configured; desktop launch disables Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
